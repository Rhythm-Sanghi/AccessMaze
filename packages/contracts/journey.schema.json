{
  "$defs": {
    "Exploration": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "recover_navigation": {
          "default": false,
          "title": "Recover Navigation",
          "type": "boolean"
        },
        "max_depth": {
          "default": 2,
          "maximum": 4,
          "minimum": 1,
          "title": "Max Depth",
          "type": "integer"
        },
        "max_actions": {
          "default": 50,
          "maximum": 200,
          "minimum": 1,
          "title": "Max Actions",
          "type": "integer"
        }
      },
      "title": "Exploration",
      "type": "object"
    },
    "NetworkPolicy": {
      "additionalProperties": false,
      "properties": {
        "navigation_origins": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Navigation Origins",
          "type": "array"
        },
        "resource_origins": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Resource Origins",
          "type": "array"
        }
      },
      "title": "NetworkPolicy",
      "type": "object"
    },
    "Privacy": {
      "additionalProperties": false,
      "properties": {
        "capture_page_text": {
          "default": false,
          "title": "Capture Page Text",
          "type": "boolean"
        }
      },
      "title": "Privacy",
      "type": "object"
    },
    "Profile": {
      "additionalProperties": false,
      "properties": {
        "action_timeout_ms": {
          "default": 10000,
          "maximum": 30000,
          "minimum": 1000,
          "title": "Action Timeout Ms",
          "type": "integer"
        },
        "keyboard_only": {
          "default": true,
          "title": "Keyboard Only",
          "type": "boolean"
        },
        "reduced_motion": {
          "default": false,
          "title": "Reduced Motion",
          "type": "boolean"
        },
        "viewport_width": {
          "default": 1280,
          "maximum": 3840,
          "minimum": 320,
          "title": "Viewport Width",
          "type": "integer"
        },
        "viewport_height": {
          "default": 800,
          "maximum": 2160,
          "minimum": 240,
          "title": "Viewport Height",
          "type": "integer"
        },
        "network_latency_ms": {
          "default": 0,
          "maximum": 3000,
          "minimum": 0,
          "title": "Network Latency Ms",
          "type": "integer"
        }
      },
      "title": "Profile",
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "action": {
          "enum": [
            "navigate",
            "fill",
            "activate",
            "press",
            "assert_visible",
            "assert_value",
            "assert_errors",
            "assert_modal",
            "assert_focus",
            "offline",
            "online",
            "wait",
            "audit",
            "upload"
          ],
          "title": "Action",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Target"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value": {
          "default": "",
          "maxLength": 2000,
          "title": "Value",
          "type": "string"
        },
        "optional": {
          "default": false,
          "title": "Optional",
          "type": "boolean"
        },
        "effect": {
          "default": false,
          "title": "Effect",
          "type": "boolean"
        },
        "value_from": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value From"
        },
        "file_label": {
          "default": "",
          "maxLength": 200,
          "title": "File Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "action"
      ],
      "title": "Step",
      "type": "object"
    },
    "Target": {
      "additionalProperties": false,
      "properties": {
        "by": {
          "default": "role",
          "enum": [
            "role",
            "label"
          ],
          "title": "By",
          "type": "string"
        },
        "role": {
          "enum": [
            "button",
            "link",
            "textbox",
            "checkbox",
            "combobox",
            "heading",
            "status",
            "alert",
            "dialog",
            "radio",
            "spinbutton"
          ],
          "title": "Role",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "role",
        "name"
      ],
      "title": "Target",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "name": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "target": {
      "maxLength": 2048,
      "title": "Target",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/Step"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    },
    "profile": {
      "$ref": "#/$defs/Profile"
    },
    "max_seconds": {
      "default": 60,
      "maximum": 300,
      "minimum": 1,
      "title": "Max Seconds",
      "type": "integer"
    },
    "tab_budget": {
      "default": 60,
      "maximum": 200,
      "minimum": 1,
      "title": "Tab Budget",
      "type": "integer"
    },
    "allow_local": {
      "default": false,
      "title": "Allow Local",
      "type": "boolean"
    },
    "exploration": {
      "$ref": "#/$defs/Exploration"
    },
    "network": {
      "$ref": "#/$defs/NetworkPolicy"
    },
    "privacy": {
      "$ref": "#/$defs/Privacy"
    }
  },
  "required": [
    "name",
    "target",
    "steps"
  ],
  "title": "Journey",
  "type": "object"
}
